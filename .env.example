# Optional. Without it the app still runs: mock interview uses the local question
# bank, extraction uses rule-based parsing, and YouTube translation falls back to
# the local Google Translate script.
OPENAI_API_KEY=

# Model used for every OpenAI call (question generation, scoring, extraction,
# subtitle translation).
OPENAI_MODEL=gpt-5.2

# Absolute site URL, used for canonical metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=

# --- Optional tuning -------------------------------------------------------
# Per-call OpenAI budget in ms (default 30000).
# OPENAI_TIMEOUT_MS=30000
# Budget for a yt-dlp / translation subprocess in ms (default 90000).
# PYTHON_SCRIPT_TIMEOUT_MS=90000
# Max caption segments translated per video (default 900).
# MAX_CAPTION_SEGMENTS=900
# Rate limit per client IP (defaults: 10 requests / 60000 ms).
# RATE_LIMIT_MAX_HITS=10
# RATE_LIMIT_WINDOW_MS=60000
# Set to "memory" on serverless platforms where the filesystem is read-only.
# CACHE_BACKEND=memory
# Interpreter used for the subtitle scripts (default python3).
# PYTHON_BIN=python3
